{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubagentStatusPayload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["in_progress", "completed", "failed", "cancelled", "timed_out"]
    },
    "result": {
      "type": "string"
    },
    "error": {
      "type": "string"
    }
  },
  "required": ["status"]
}
