# Scientific Tumbleweed environment template
#
# Copy this file to `.env` and fill only the providers/features you actually enable
# in `config.yaml` or `extensions_config.json`. Never commit real secrets.

# =============================================================================
# Model Providers
# =============================================================================
# The default `config.example.yaml` currently references OPENAI_API_KEY,
# GEMINI_API_KEY, and ANTHROPIC_API_KEY. If you route several models through the
# same OpenAI-compatible gateway, it is OK for these variables to contain that
# gateway key, as long as `config.yaml` points at the matching base_url/api_base.

# OpenAI or OpenAI-compatible gateways used by `langchain_openai:ChatOpenAI`.
# OPENAI_API_KEY=your-openai-or-compatible-api-key

# Google Gemini. In `langchain_google_genai` configs this may be exposed as
# `gemini_api_key`; in OpenAI-compatible configs it is still read from this env.

# Browser CORS allowlist for split-origin or port-forwarded deployments (comma-separated exact origins).
# Leave unset when using the unified nginx endpoint, e.g. http://localhost:2026.
# GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# GEMINI_API_KEY=your-gemini-api-key

# Anthropic Claude API. Claude Code OAuth can also be used without this key if
# your model config uses `deerflow.models.claude_provider:ClaudeChatModel`.
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Native DeepSeek provider used by the setup wizard when selected.
# DEEPSEEK_API_KEY=your-deepseek-api-key

# OpenRouter or another broad OpenAI-compatible model gateway.
# OPENROUTER_API_KEY=your-openrouter-api-key

# Self-hosted vLLM. Some local vLLM servers accept any non-empty placeholder.
# VLLM_API_KEY=your-vllm-api-key-or-placeholder

# Other optional OpenAI-compatible providers used by example docs/configs.
# NOVITA_API_KEY=your-novita-api-key
# MINIMAX_API_KEY=your-minimax-api-key
# MOONSHOT_API_KEY=your-moonshot-api-key

# Shared gateway key used by local sandbox skills/tools that expect DMXAPI.
# DMXAPI_API_KEY=your-dmxapi-api-key

# Claude Code OAuth fallback envs for `deerflow.models.claude_provider`.
# CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token
# ANTHROPIC_AUTH_TOKEN=your-anthropic-auth-token
# CLAUDE_CODE_CREDENTIALS_PATH=/absolute/path/to/claude/credentials.json


# =============================================================================
# Tool APIs
# =============================================================================
# These are runtime tools configured under `tools:` in `config.yaml`, or MCP
# servers configured in `extensions_config.json`. Fill only the providers you
# enable there.

# Tool: web_search via Tavily. General web search.
# TAVILY_API_KEY=your-tavily-api-key

# Tool: web_search via Serper. Google Search API.
# SERPER_API_KEY=your-serper-api-key

# Tool: web_search/web_fetch/image_search via InfoQuest. Higher quality search,
# crawl, and image search when those InfoQuest tools are enabled.
# INFOQUEST_API_KEY=your-infoquest-api-key

# Tool: web_search/web_fetch via Exa. Neural/keyword search and page contents.
# EXA_API_KEY=your-exa-api-key

# Tool: web_search/web_fetch via Firecrawl. Search, scrape, and crawl pages.
# FIRECRAWL_API_KEY=your-firecrawl-api-key

# Tool: web_fetch via Jina AI Reader. Optional authorization for page reading.
# JINA_API_KEY=your-jina-api-key

# Tool group: academic_search. OpenAlex + Semantic Scholar paper search,
# paper details, recommendations, BibTeX, authors, and citation networks.
# SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key
# OPENALEX_EMAIL=you@example.com

# MCP tool: GitHub server in `extensions_config.json`. Repository/issues/PR ops.
# GITHUB_TOKEN=your-github-personal-access-token


# =============================================================================
# Skill APIs
# =============================================================================
# These variables are used by scripts inside `skills/public/**`. Configure them
# only if you invoke the corresponding skill.

# Skill: image-generation. Generates images through the DMXAPI gateway.
# Uses DMXAPI_API_KEY from the Model Providers section.

# Skill: ncbi-entrez-skill. Searches/fetches PubMed, Gene, Protein, Nucleotide,
# PMC, and other NCBI Entrez records. API key is optional but raises rate limits.
# NCBI_API_KEY=your-ncbi-api-key
# NCBI_EUTILS_API_KEY=your-ncbi-eutils-api-key
# NCBI_EMAIL=you@example.com
# NCBI_TOOL=scientific-tumbleweed

# Skill: ncbi-pmc-skill. Checks PMC Open Access availability and metadata.
# Reuses the same NCBI variables as ncbi-entrez-skill.
# NCBI_API_KEY=your-ncbi-api-key
# NCBI_EUTILS_API_KEY=your-ncbi-eutils-api-key
# NCBI_EMAIL=you@example.com
# NCBI_TOOL=scientific-tumbleweed

# Skill: ncbi-blast-skill. Submits and polls NCBI BLAST jobs. Requires an email
# for submit/run actions; NCBI_TOOL is used as the client identifier.
# NCBI_EMAIL=you@example.com
# NCBI_TOOL=scientific-tumbleweed

# Skill: ppt-master. Generates slide images/visuals. Pick one IMAGE_BACKEND,
# then fill that backend's key. *_MODEL and *_BASE_URL are optional overrides.
# IMAGE_BACKEND=gemini

# ppt-master backend: gemini. Google image generation.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.1-flash-image-preview
# GEMINI_BASE_URL=https://your-gemini-compatible-endpoint

# ppt-master backend: openai. DMXAPI by default, with OpenAI-compatible
# overrides. DMXAPI_API_KEY is preferred; OPENAI_API_KEY is a fallback.
# DMXAPI_API_KEY=your-dmxapi-api-key
# OPENAI_API_KEY=your-openai-or-compatible-api-key
# OPENAI_MODEL=gpt-image-2
# OPENAI_BASE_URL=https://www.dmxapi.cn/v1

# ppt-master backend: minimax. MiniMax image generation.
# MINIMAX_API_KEY=your-minimax-api-key
# MINIMAX_MODEL=image-01
# MINIMAX_BASE_URL=https://api.minimax.io/v1/image_generation

# ppt-master backend: qwen. Alibaba Qwen/DashScope image generation.
# QWEN_API_KEY=your-qwen-api-key
# DASHSCOPE_API_KEY=your-dashscope-api-key
# QWEN_MODEL=qwen-image-2.0-pro
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis

# ppt-master backend: zhipu. Zhipu/BigModel image generation.
# ZHIPU_API_KEY=your-zhipu-api-key
# BIGMODEL_API_KEY=your-bigmodel-api-key
# ZHIPU_MODEL=glm-image
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/images/generations

# ppt-master backend: volcengine. Volcengine/ARK Seedream image generation.
# VOLCENGINE_API_KEY=your-volcengine-api-key
# ARK_API_KEY=your-ark-api-key
# VOLCENGINE_MODEL=doubao-seedream
# VOLCENGINE_BASE_URL=https://operator.las.cn-beijing.volces.com/api/v1/images/generations

# ppt-master backend: stability. Stability AI image generation.
# STABILITY_API_KEY=your-stability-api-key
# STABILITY_MODEL=stable-image-core
# STABILITY_BASE_URL=https://api.stability.ai

# ppt-master backend: bfl. Black Forest Labs FLUX image generation.
# BFL_API_KEY=your-bfl-api-key
# BFL_MODEL=flux-pro-1.1-ultra
# BFL_BASE_URL=https://api.bfl.ai

# ppt-master backend: ideogram. Ideogram image generation.
# IDEOGRAM_API_KEY=your-ideogram-api-key
# IDEOGRAM_MODEL=ideogram-v3
# IDEOGRAM_BASE_URL=https://api.ideogram.ai

# ppt-master backend: siliconflow. SiliconFlow image generation.
# SILICONFLOW_API_KEY=your-siliconflow-api-key
# SILICONFLOW_MODEL=Qwen/Qwen-Image
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/images/generations

# ppt-master backend: fal. fal.ai image generation.
# FAL_KEY=your-fal-api-key
# FAL_API_KEY=your-fal-api-key
# FAL_MODEL=fal-ai/imagen3/fast
# FAL_BASE_URL=https://fal.run

# ppt-master backend: replicate. Replicate image generation.
# REPLICATE_API_TOKEN=your-replicate-api-token
# REPLICATE_API_KEY=your-replicate-api-key
# REPLICATE_MODEL=black-forest-labs/flux-1.1-pro
# REPLICATE_BASE_URL=https://api.replicate.com/v1/predictions

# ppt-master backend: openrouter. Routes image-capable models through OpenRouter.
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=google/gemini-3.1-flash-image-preview
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Skill: chart-visualization. Optional visualization service routing.
# VIS_REQUEST_SERVER=http://localhost:3000
# SERVICE_ID=your-visualization-service-id

# Skill: skill-creator. Can improve skill descriptions with Claude Code auth.
# No separate API key is required if Claude Code OAuth is already available.


# =============================================================================
# Observability
# =============================================================================
# Disabled by default. Set the *_TRACING flag to true only when the credentials
# below are also configured.

# LangSmith tracing for LangChain/LangGraph runs.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=scientific-tumbleweed

# Legacy LangChain tracing variables are still supported, but LANGSMITH_* wins.
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=your-langchain-api-key
# LANGCHAIN_PROJECT=scientific-tumbleweed
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Langfuse tracing.
LANGFUSE_TRACING=false
# LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
# LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com


# =============================================================================
# Application Runtime
# =============================================================================
# Backend config file locations. Usually you do not need to change these for
# local development.
# DEER_FLOW_CONFIG_PATH=/absolute/path/to/config.yaml
# DEER_FLOW_EXTENSIONS_CONFIG_PATH=/absolute/path/to/extensions_config.json
# DEER_FLOW_HOME=/absolute/path/to/runtime-data

# =============================================================================
# PostgreSQL (ParadeDB: Postgres 16 + pgvector + pg_search/BM25)
# =============================================================================
# Backs LangGraph checkpointer/store and application tables
# (users, user_memory, tool_cache, channel_threads).
# The docker-compose paradedb service reads POSTGRES_DB/USER/PASSWORD below.
POSTGRES_DB=scientifictumbleweed
POSTGRES_USER=scientifictumbleweed
POSTGRES_PASSWORD=scientifictumbleweed
POSTGRES_HOST_PORT=55432

# DSN used by the backend to connect. From inside docker-compose networks
# the host is `paradedb`; on the host machine use `localhost`.
# Inside compose:
POSTGRES_DSN=postgresql://scientifictumbleweed:scientifictumbleweed@paradedb:5432/scientifictumbleweed
# On host (override locally when running without docker):
# POSTGRES_DSN=postgresql://scientifictumbleweed:scientifictumbleweed@localhost:55432/scientifictumbleweed

# Gateway API settings.
# GATEWAY_HOST=0.0.0.0
# GATEWAY_PORT=8001
# GATEWAY_WORKERS=4
# GATEWAY_ENABLE_DOCS=true
# CORS_ORIGINS=http://localhost:3000,http://localhost:2026

# Auth/session security. Required for stable production sessions; local dev can
# auto-generate ephemeral secrets, but sessions will reset on restart.
# AUTH_JWT_SECRET=generate-with-python-secrets-token-urlsafe-32
# BETTER_AUTH_SECRET=generate-with-python-secrets-token-hex-32

# Frontend/backend routing. Most local and Docker setups can keep these unset.
# NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8001
# NEXT_PUBLIC_LANGGRAPH_BASE_URL=http://localhost:2024
# NEXT_PUBLIC_STATIC_WEBSITE_ONLY=false
# DEER_FLOW_INTERNAL_GATEWAY_BASE_URL=http://gateway:8001
# DEER_FLOW_INTERNAL_LANGGRAPH_BASE_URL=http://langgraph:2024


# =============================================================================
# IM Channels
# =============================================================================
# Enable the matching channel in `config.yaml` before setting these.

# Feishu/Lark.
# FEISHU_APP_ID=your-feishu-app-id
# FEISHU_APP_SECRET=your-feishu-app-secret

# Slack Socket Mode.
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_APP_TOKEN=xapp-your-slack-app-token

# Telegram bot.
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# WeChat / iLink.
# WECHAT_BOT_TOKEN=your-wechat-or-ilink-bot-token
# WECHAT_ILINK_BOT_ID=your-wechat-ilink-bot-id

# WeCom AI Bot.
# WECOM_BOT_ID=your-wecom-bot-id
# WECOM_BOT_SECRET=your-wecom-bot-secret

# Channel service URLs. In Docker Compose, use service names instead of localhost.
# DEER_FLOW_CHANNELS_LANGGRAPH_URL=http://langgraph:2024
# DEER_FLOW_CHANNELS_GATEWAY_URL=http://gateway:8001


# =============================================================================
# Sandbox
# =============================================================================
# AIO sandbox path/network translation. These help the backend translate between
# host paths and sandbox/container-visible paths.
# DEER_FLOW_HOST_BASE_DIR=/absolute/path/to/runtime-data
# DEER_FLOW_HOST_SKILLS_PATH=/absolute/path/to/skills
# DEER_FLOW_SANDBOX_HOST=localhost
# DEER_FLOW_SANDBOX_BIND_HOST=127.0.0.1


# =============================================================================
# Docker
# =============================================================================
# Docker Compose production/development helpers.
# PORT=2026
# DEER_FLOW_REPO_ROOT=/absolute/path/to/scientific-tumbleweed-monorepo
# DEER_FLOW_DOCKER_SOCKET=/var/run/docker.sock
# LANGGRAPH_UPSTREAM=gateway:8001
# LANGGRAPH_REWRITE=/api/
# LANGGRAPH_JOBS_PER_WORKER=10
# LANGGRAPH_ALLOW_BLOCKING=0

# Build mirrors and package indexes for restricted networks.
# UV_INDEX_URL=https://pypi.org/simple
# PIP_INDEX_URL=https://pypi.org/simple
# NPM_REGISTRY=https://registry.npmjs.org
# APT_MIRROR=
# PNPM_STORE_PATH=/root/.local/share/pnpm/store


# =============================================================================
# Kubernetes
# =============================================================================
# Optional K8s sandbox provisioner settings.
# SANDBOX_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:latest
# K8S_NAMESPACE=scientific-tumbleweed
# LEGACY_K8S_NAMESPACE=deer-flow
# K8S_API_SERVER=https://host.docker.internal:26443
# KUBECONFIG_PATH=/root/.kube/config
# SKILLS_HOST_PATH=/absolute/path/to/skills
# THREADS_HOST_PATH=/absolute/path/to/threads
# SKILLS_PVC_NAME=
# USERDATA_PVC_NAME=
# NODE_HOST=host.docker.internal
